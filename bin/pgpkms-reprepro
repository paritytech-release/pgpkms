#!/bin/bash

# This is a hook script for reprepro to perform KMS-based signing operations
# It takes three parameters, according to https://salsa.debian.org/debian/reprepro/-/blob/debian/docs/manual.html:

#The script gets three arguments:
#-The filename to sign,
#-the filename of the InRelease file to create and
#-the filename of the Release.gpg to create
#(a Release.gpg does not need to be created. 
#reprepro will assume you do not care about that legacy file if it is not created).

#see the RFC first if you encountered with any signature validation issues and you want to change the code
#https://datatracker.ietf.org/doc/html/rfc2440#section-7.1

GPG_INLINE_HEADER="-----BEGIN PGP SIGNED MESSAGE-----"
GPG_HASH_HEADER="Hash: $(echo "$PGP_KMS_HASH" | tr '[:lower:]' '[:upper:]')"

FILENAME_TO_SIGN="$1"
IN_RELEASE_FILE_INLINED="$2"
RELEASE_GPG_FILE_DETACHED="$3"
set -e

if [[ -z "$FILENAME_TO_SIGN" ]]; then
   echo "Reprepro-KMS signing error: no source filename have been supplied"
   exit 1
fi

if [[ -z "$IN_RELEASE_FILE_INLINED" ]]; then
   echo "Reprepro-KMS signing error: no InRelease filename have been supplied"
   exit 2
fi

SIGNATURE_INLINE=$(cat "$FILENAME_TO_SIGN" | prepare-to-gpg-clearsign | pgpkms sign)

echo "$GPG_INLINE_HEADER" > "$IN_RELEASE_FILE_INLINED"
echo "$GPG_HASH_HEADER"  >> "$IN_RELEASE_FILE_INLINED"
echo ""                  >> "$IN_RELEASE_FILE_INLINED"
cat  "$FILENAME_TO_SIGN" >> "$IN_RELEASE_FILE_INLINED"
echo "$SIGNATURE_INLINE" >> "$IN_RELEASE_FILE_INLINED"

if [[ -n "$RELEASE_GPG_FILE_DETACHED" ]]; then
   cat "$FILENAME_TO_SIGN" | pgpkms sign > "$RELEASE_GPG_FILE_DETACHED"
fi
